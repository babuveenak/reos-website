# ---------------------------------------------------------------------------
# REOS website configuration
#
# Copy to `.env.local` for local development. For production, set these in the
# Vercel project's Environment Variables, then redeploy.
#
# This site is statically exported, so these values are baked in at build time.
# Changing one takes effect on the NEXT DEPLOY, not immediately.
#
# Every variable is optional — each falls back to the default shown.
# ---------------------------------------------------------------------------

# Where demo requests and enquiries are sent.
# Change this and every mailto link and the demo form follow it.
NEXT_PUBLIC_CONTACT_EMAIL=aiworkingforme@gmail.com

# Canonical origin. Used for page metadata, Open Graph URLs and the sitemap.
# No trailing slash. Set this if you move to a custom domain.
NEXT_PUBLIC_SITE_URL=https://reos-website.vercel.app

# Optional. When set, shown next to the email address on the demo page.
NEXT_PUBLIC_CONTACT_PHONE=

# Optional. A scheduling link (Calendly, Cal.com, Teams booking, etc).
# When set, the demo page offers "Pick a time" alongside the enquiry form.
NEXT_PUBLIC_BOOKING_URL=

# Subject line prefix on enquiry emails.
NEXT_PUBLIC_ENQUIRY_SUBJECT=REOS demo request
